<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodexSyncWizard.Avalonia.MainWindow"
        Title="Codex 对话同步"
        Width="900" Height="600"
        MinWidth="640" MinHeight="500"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Icon="/app.ico"
        DragDrop.AllowDrop="True">

    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="Codex 对话同步" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" LetterSpacing="0.5"/>
                <TextBlock Text="点任一渠道查看 / 选择 / 迁移对话" Classes="muted" FontSize="12"/>
            </StackPanel>
            <Border Grid.Column="1" CornerRadius="999" Padding="10,4" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusPillText" Text="待命" FontSize="11" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Path bar -->
        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PathLabel" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="ChangeDirBtn" Grid.Column="1" Classes="link" Content="更换" Click="OnChangeDir"/>
            <Button x:Name="RefreshBtn" Grid.Column="2" Classes="link" Content="刷新" Margin="12,0,0,0" Click="OnRefresh"/>
        </Grid>

        <Border Grid.Row="2" Height="1" Background="{StaticResource BorderBrush2}" Margin="0,14,0,0"/>

        <!-- Status text -->
        <TextBlock Grid.Row="3" x:Name="StatusLabel" Classes="muted" Margin="0,16,0,0" Text="扫描中..." FontSize="12"/>

        <!-- 一键归并 hero 面板 -->
        <Border Grid.Row="4" x:Name="ConsolidatePanel" Background="{StaticResource HighlightPanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Padding="20,16" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="一键归并到主渠道" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                        <TextBlock Text="把所有对话归到:" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" x:Name="ConsolidateTarget" Width="180" SelectedIndex="-1"/>
                        <TextBlock Grid.Column="2" x:Name="ConsolidatePlan" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                </StackPanel>

                <Button Grid.Column="1" x:Name="ConsolidateBtn" Classes="primary" Content="一键归并" MinWidth="120" Click="OnConsolidate" IsEnabled="False" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>
        </Border>

        <!-- Provider cards -->
        <ScrollViewer Grid.Row="5" Margin="0,12,0,0" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ProvidersWrap">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="6" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Classes="link" Content="高级" Click="OnAdvanced"/>
            <Button Classes="link" Content="批量" Margin="16,0,0,0" Click="OnBulk"/>
            <Button Classes="link" Content="命令" Margin="16,0,0,0" Click="OnCommand"/>
            <Button x:Name="UpdateLink" Grid.Column="4" Classes="link" Content="" IsVisible="False" Click="OnUpdateLink"/>
        </Grid>
    </Grid>
</Window>
