<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodexSyncWizard.Avalonia.BulkOperationsWindow"
        Title="批量操作"
        Width="640" Height="600"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Icon="/app.ico">

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="批量操作" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="一键迁移 / 删除整个 provider 的全部对话" Classes="muted" FontSize="11"/>
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrush2}" Margin="0,12,0,0"/>

        <TextBlock Grid.Row="2" Classes="section" Text="迁移整个 provider" Margin="0,16,0,0"/>
        <Grid Grid.Row="3" Margin="0,8,0,0" ColumnDefinitions="80,*,40,80,*,Auto">
            <TextBlock Grid.Column="0" Text="把" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="MigrateFrom" PlaceholderText="源 provider" SelectedIndex="-1"/>
            <TextBlock Grid.Column="2" Text="迁到" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="目标" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="4" x:Name="MigrateTo" PlaceholderText="目标 provider" SelectedIndex="-1"/>
            <Button Grid.Column="5" x:Name="MigrateBtn" Content="迁移" MinWidth="80" Margin="8,0,0,0" Click="OnMigrate" Classes="primary" IsEnabled="False"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0" ColumnDefinitions="*,Auto">
            <CheckBox Grid.Column="0" x:Name="MigrateAll" Content="或者：把所有非目标 provider 的对话全合并到目标"/>
            <Button Grid.Column="1" x:Name="MergeAllBtn" Content="一键合并" MinWidth="80" Margin="8,0,0,0" Click="OnMergeAll" IsEnabled="False"/>
        </Grid>

        <Border Grid.Row="5" Height="1" Background="{StaticResource BorderBrush2}" Margin="0,16,0,0"/>

        <Grid Grid.Row="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Classes="section" Text="删除整个 provider 的对话" Margin="0,14,0,0"/>
            <Grid Grid.Row="1" Margin="0,8,0,0" ColumnDefinitions="80,*,Auto">
                <TextBlock Grid.Column="0" Text="渠道" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="DeleteProvider" PlaceholderText="选 provider" SelectedIndex="-1"/>
                <Button Grid.Column="2" x:Name="DeleteBtn" Content="删除" MinWidth="80" Margin="8,0,0,0" Click="OnDelete" IsEnabled="False"/>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="4" Margin="0,16,0,0">
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogBox" FontFamily="Consolas, Menlo, monospace" FontSize="11" Padding="10,8" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="7" Margin="0,12,0,0" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="StatusLabel" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="关闭" MinWidth="80" Click="OnClose"/>
        </Grid>
    </Grid>
</Window>
